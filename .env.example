# Hugging Face token. Only needed if your fine-tuned model repo is private/gated.
HF_TOKEN=

# The fine-tuned model the app and eval load.
FINETUNED_MODEL=your-username/claims-text-to-sql

# The un-finetuned base checkpoint, used as the eval baseline.
# Must be the same checkpoint train.ipynb started from, or the comparison is
# between two different models rather than between fine-tuned and not.
BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Backend used by app.py and api.py: finetuned | base | anthropic
BACKEND=finetuned

# Only needed for the frontier baseline in the eval.
ANTHROPIC_API_KEY=
